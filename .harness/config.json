{
  "authorities": {
    "change": "github-pull-requests",
    "evidence": "github-checks",
    "integration": "github-rules",
    "product": "repository-docs",
    "revision": "github-target-ref",
    "work": "repository-backlog",
    "workspace": "git-worktree"
  },
  "envelope": {
    "excluded_transitions": [
      "arbitrary-local-writes",
      "administrator-policy-reconfiguration"
    ],
    "trusted_actors": [
      "repository-admins",
      "ci-maintainers",
      "local-executor"
    ],
    "workspace_writers": "single"
  },
  "mode": "cooperative",
  "profile": "github-backlog-v1",
  "repository": "Teyvat-Survivors/Teyvat-Survivors",
  "schema": 1,
  "target": "develop",
  "verification": {
    "commands": [
      [
        "lua",
        "tests/run.lua"
      ],
      [
        "npx",
        "--yes",
        "backlog.md@1.53.0",
        "task",
        "list",
        "--json"
      ]
    ],
    "controller": null,
    "environment": {},
    "expected_app_id": 15368,
    "material_inputs": [
      "backlog/config.yml"
    ],
    "required_check": "Lua and Backlog",
    "sandbox_image": null,
    "workflow": ".github/workflows/ci.yml"
  },
  "work": {
    "actors": {
      "@FurinyaDev": "FurinyaDev"
    },
    "directories": [
      "backlog/tasks",
      "backlog/completed",
      "backlog/archive/tasks"
    ],
    "done_status": "Done",
    "format": "backlog-md-1.53-subset-v1",
    "ready_statuses": [
      "To Do",
      "In Progress"
    ]
  }
}
